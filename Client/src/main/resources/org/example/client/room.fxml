<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.collections.FXCollections?>
<?import java.lang.Integer?>
<?import java.lang.Byte?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.client.controllers.RoomController">
   <top>
      <Label text="Tactic Battle Rush" BorderPane.alignment="CENTER">
         <font>
            <Font name="Marlett" size="22.0" />
         </font>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <bottom>
      <Label text="DanilovProfGroup.com" textAlignment="CENTER" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
         <font>
            <Font size="10.0" />
         </font>
      </Label>
   </bottom>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-alignment: center;" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="room_number" />
            <Label fx:id="status" />
            <ComboBox fx:id="countOfUnitsComboBox" prefWidth="150.0" promptText="Кол-во юнитов" visibleRowCount="5">
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
               <items>
                  <FXCollections fx:factory="observableArrayList">
                     <Byte fx:value="1"/>
                     <Byte fx:value="2"/>
                     <Byte fx:value="3"/>
                     <Byte fx:value="4"/>
                     <Byte fx:value="5"/>
                  </FXCollections>
               </items>
            </ComboBox>
            <Button fx:id="readyButton" mnemonicParsing="false" onMouseClicked="#ready" text="I`m ready">
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="exitButton" mnemonicParsing="false" onMouseClicked="#exit" text="Exit">
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets bottom="50.0" left="200.0" right="200.0" top="50.0" />
         </BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
