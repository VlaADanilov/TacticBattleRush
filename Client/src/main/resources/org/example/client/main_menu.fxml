<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane styleClass="main-menu" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.client.controllers.MainMenuController">
    <top>
        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="game-title" text="Tactic Battle Rush" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="75.0" />
            </BorderPane.margin>
        </Text>
    </top>
    <bottom>
        <Label text="DanilovProfGroup.com" textAlignment="CENTER" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="10.0" />
            </BorderPane.margin>
            <font>
                <Font size="10.0" />
            </font>
        </Label>
    </bottom>
   <center>
      <Button styleClass="menu-button" fx:id="startButton" mnemonicParsing="false" text="Start game!" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
